#!/bin/sh
# One host entry point. Bend owns transitions; the host owns processes/files.
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BEND="${BEND:-$HOME/.bend/bin/bend}"
export BEND_NO_TELEMETRY=1
usage() {
    cat <<'HELP'
usage: mundus <verb> <root> [args...]

Immutable Lorenz worker history:
  init ROOT
  capture ROOT TASK [ACTOR ORIGIN]
  work ROOT CONVERSATION ACTOR OWNER ACCEPTANCE
  worker ROOT ACTOR LABEL RUNTIME
  claim ROOT WORK WORKER ACTOR
  packet ROOT WORK
  return ROOT WORK WORKER ACTOR RESULT EVIDENCE
  learn ROOT RESULT DEPENDENCY ACTOR TEXT
  remember ROOT CONVERSATION DEPENDENCY ACTOR TEXT
  correct ROOT MEMORY DEPENDENCY ACTOR REASON TEXT
  history|memory|status ROOT
  explain ROOT ID
  opencode ROOT WORK PORT SESSION RECEIPT

Separate experimental planner/retrieval state (not worker execution):
  plan ROOT BUDGET DEPTH       abstract numeric planning fixture
  retrieve ROOT               local graph fixture, not Buzz retrieval
  path ROOT VERB              experimental kernel slot path

Host utilities:
  op list|run ...             checked operation driver
  guard check|snapshot|verify ...
  help

Snapshots stay under ROOT/snapshots; ROOT/head selects the immutable current
snapshot. One local writer lock; no cross-node lock, automatic learning or
relay synchronization. Read history for actual record identifiers.
HELP
}
verb=${1:-help}
case "$verb" in
    help|-h|--help) usage; exit 0 ;;
    op) shift; exec "$SELF_DIR/runtime/ops/run.sh" "$@" ;;
    guard) shift; exec "$SELF_DIR/scripts/durability-guard.sh" "$@" ;;
    init|capture|work|worker|claim|packet|return|learn|remember|correct|history|memory|status|explain|opencode)
        exec "$SELF_DIR/runtime/worker/run.sh" "$@" ;;
    plan|retrieve|path)
        [ "$#" -ge 2 ] || { usage >&2; exit 64; }
        root=$2
        [ -n "$root" ] || { usage >&2; exit 64; }
        shift 2
        case "$root" in /*) ;; *) root="$PWD/$root" ;; esac
        if [ "$verb" != path ]; then
            umask 077
            mkdir -p "$root/planner"
        fi
        exec "$BEND" "$SELF_DIR/runtime/mundus.bend" -- "$verb" "$root/planner" "$@"
        ;;
    *) echo "mundus: unknown verb: $verb" >&2; exit 64 ;;
esac

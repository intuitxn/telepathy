#!/bin/sh
set -eu
SOURCE="$0"
while [ -L "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
ROOT="$(CDPATH= cd -- "$(dirname -- "$SOURCE")/../.." && pwd)"
if [ -n "${TELEPATHY_PYTHON:-}" ]; then
  exec "$TELEPATHY_PYTHON" "$ROOT/runtime/programs/cli.py" "$@"
fi
NUDGE_ROOT="${NUDGE_ROOT:-$(dirname "$ROOT")/nudge}"
if [ -x "$NUDGE_ROOT/.venv/bin/python3.12" ]; then
  export NUDGE_ROOT
  exec "$NUDGE_ROOT/.venv/bin/python3.12" "$ROOT/runtime/programs/cli.py" "$@"
fi
exec python3 "$ROOT/runtime/programs/cli.py" "$@"

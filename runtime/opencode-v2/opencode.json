{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "intuitxn-plan",
  "warming": false,
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },
  "agents": {
    "intuitxn-plan": {
      "description": "Scope an intuitxn job from its source context and acceptance criteria.",
      "mode": "primary",
      "system": "Prepare a concrete job brief for the desk engine. Read AGENTS.md and docs/HARNESS_STATE.md. A job needs owner, repository, runtime, request, acceptance, optional context. Identify evidence and unknowns. Do not invent company priorities, claim work is deployed, or execute the job yourself.",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
